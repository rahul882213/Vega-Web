# Server listen port (Render, Railway, Fly.io, Koyeb set PORT automatically)
PORT=3000
NODE_ENV=production

# Comma-separated allowed browser origins for CORS, or * for any origin.
# Example for strict GitHub Pages + local dev:
# ALLOWED_ORIGINS=https://rahul882213.github.io,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=*

# Upstream HTTP request timeout in milliseconds (default: 30000)
UPSTREAM_TIMEOUT_MS=30000

# Provider base-url cache TTL in milliseconds (default: 3600000 = 1 hour)
MODFLIX_TTL_MS=3600000
